<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cinzel&family=Raleway:wght@300&display=swap');
        body, html { margin: 0; padding: 0; width: 100%; height: 100%; background: #000; color: #fff; font-family: 'Raleway', sans-serif; overflow: hidden; text-align: center; }
        .borda-roxa { position: fixed; top: 0; left: 0; right: 0; bottom: 0; border: 5px solid #8a2be2; box-shadow: inset 0 0 25px #8a2be2, 0 0 15px #8a2be2; z-index: 999; pointer-events: none; animation: pulsarBorda 2s infinite alternate; }
        @keyframes pulsarBorda { from { opacity: 0.4; } to { opacity: 1; } }
        canvas { position: fixed; top: 0; left: 0; z-index: 1; pointer-events: none; }
        .sala { position: fixed; top: 0; left: 0; width: 100%; height: 100%; display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 10; padding: 20px; box-sizing: border-box; }
        .ativa { display: flex !important; animation: fadeIn 0.8s forwards; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        .aura { position: absolute; width: 100%; height: 100%; background: radial-gradient(circle, rgba(138, 43, 226, 0.3) 0%, transparent 70%); z-index: -1; filter: blur(50px); }
        h1, h2 { font-family: 'Cinzel', serif; color: #bc8cf2; text-shadow: 0 0 10px #8a2be2; margin: 10px 0; }
        .moldura { width: 240px; height: 110px; border: 1px solid #8a2be2; margin: 3px; background: #111; overflow: hidden; border-radius: 4px; }
        .foto { width: 100%; height: 100%; object-fit: cover; }
        .legenda { background: rgba(20, 20, 20, 0.85); border: 1px solid #8a2be2; color: #fff; padding: 10px; width: 260px; font-size: 0.8rem; margin: 10px 0; border-radius: 5px; font-style: italic; }
        button { background: #8a2be2; border: none; color: white; padding: 12px 35px; font-family: 'Cinzel'; cursor: pointer; border-radius: 25px; font-weight: bold; box-shadow: 0 0 15px #8a2be2; z-index: 1000; position: relative; }
    </style>
</head>
<body>

<div class="borda-roxa"></div>
<canvas id="nuvem"></canvas>

<div id="sala0" class="sala ativa">
    <div class="aura"></div>
    <h1 style="letter-spacing:5px;">ACERVO SOFI</h1>
    <button onclick="ir(0, 1)">INICIAR</button>
</div>

<div id="container-anos"></div>

<div id="sala20" class="sala">
    <div class="aura"></div>
    <h2>SOBRE NÓS ❤️</h2>
    <div class="moldura"><img src="nos_1.jpg" class="foto"></div>
    <div class="moldura"><img src="nos_2.jpg" class="foto"></div>
    <div class="moldura"><img src="nos_3.jpg" class="foto"></div>
    <div class="legenda" contenteditable="true">Escreve aqui sobre vocês...</div>
    <button onclick="ir(20, 'cadeado')">ÚLTIMO PASSO ➔</button>
</div>

<div id="salaCadeado" class="sala">
    <div class="aura"></div>
    <div id="cadeado" onclick="abrirCadeado()" style="font-size:100px; cursor:pointer;">🔒</div>
</div>

<div id="salaFinal" class="sala">
    <div class="aura"></div>
    <div class="moldura"><img src="ia_1.jpg" class="foto"></div>
    <div class="moldura"><img src="ia_2.jpg" class="foto"></div>
    <div class="moldura"><img src="ia_3.jpg" class="foto"></div>
    <div class="legenda">
        <b style="color:#bc8cf2;">FELIZ ANIVERSÁRIO!</b><br>
        O amor vence qualquer distância. Te amo! 🇧🇷🇨🇭
    </div>
</div>

<script>
    // Gerador de salas no topo para garantir que os IDs existam IMEDIATAMENTE
    (function(){
        const titulos = ["Nascimento 🍼", "1 Ano 🧸", "2 Anos 🎂", "3 Anos 🎨", "4 Anos 🎈", "5 Anos 🎡", "6 Anos 🎒", "7 Anos 🚲", "8 Anos 🍦", "9 Anos 🎀", "10 Anos ✨", "11 Anos 📚", "12 Anos 🎧", "13 Anos 🎬", "14 Anos 📱", "15 Anos 💃", "16 Anos 🌅", "17 Anos ✈️", "18 Anos 👑"];
        const container = document.getElementById('container-anos');
        titulos.forEach((titulo, i) => {
            const id = i + 1;
            const prox = (id === 19) ? 20 : id + 1;
            const div = document.createElement('div');
            div.id = 'sala' + id;
            div.className = 'sala';
            div.innerHTML = `
                <div class="aura"></div>
                <h2>${titulo}</h2>
                <div class="moldura"><img src="foto_${id}_1.jpg" class="foto" onerror="this.src='https://via.placeholder.com/240x110/111/8a2be2?text=FOTO+1'"></div>
                <div class="moldura"><img src="foto_${id}_2.jpg" class="foto" onerror="this.src='https://via.placeholder.com/240x110/111/8a2be2?text=FOTO+2'"></div>
                <div class="moldura"><img src="foto_${id}_3.jpg" class="foto" onerror="this.src='https://via.placeholder.com/240x110/111/8a2be2?text=FOTO+3'"></div>
                <div class="legenda" contenteditable="true">Escreve a tua mensagem aqui...</div>
                <button onclick="ir(${id}, ${prox})">PRÓXIMO ➔</button>
            `;
            container.appendChild(div);
        });
    })();

    // Função de Navegação
    function ir(atualId, proximoId) {
        const atual = (atualId === 0) ? document.getElementById('sala0') : document.getElementById('sala' + atualId);
        let proximo;
        if(proximoId === 'cadeado') proximo = document.getElementById('salaCadeado');
        else if(proximoId === 'final') proximo = document.getElementById('salaFinal');
        else proximo = document.getElementById('sala' + proximoId);

        if(atual && proximo) {
            atual.classList.remove('ativa');
            proximo.classList.add('ativa');
        } else {
            console.error("Não foi possível encontrar a sala:", proximoId);
        }
    }

    function abrirCadeado() {
        document.getElementById('cadeado').innerHTML = "🔓";
        setTimeout(() => ir('Cadeado', 'final'), 600);
    }

    // Partículas (Corações)
    var can = document.getElementById('nuvem'), ctx = can.getContext('2d');
    function setSize() { can.width = window.innerWidth; can.height = window.innerHeight; }
    window.onresize = setSize; setSize();
    var pts = [];
    function animar() {
        ctx.clearRect(0, 0, can.width, can.height);
        if(pts.length < 35) pts.push({x: Math.random()*can.width, y: can.height+10, v: Math.random()*2 + 1, s: Math.random()*12+15, o: Math.random()*0.5});
        pts.forEach((p, i) => { p.y -= p.v; ctx.globalAlpha = p.o; ctx.fillStyle = "#ff0055"; ctx.font = p.s + "px serif"; ctx.fillText("❤️", p.x, p.y); if(p.y < -20) pts.splice(i, 1); });
        requestAnimationFrame(animar);
    }
    animar();
</script>
</body>
</html>
